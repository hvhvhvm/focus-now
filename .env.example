# Frontend (Vercel): Supabase project settings.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional fallback for guest mode when Supabase signup/anonymous auth is rate limited.
# Create this user once in Supabase Auth, then use these values only for a demo account.
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=replace-with-demo-password
# Frontend (Vercel): full URL of the Render API, including /api.
VITE_API_BASE_URL=https://your-api-name.onrender.com/api

# Backend (Render): use a long random value and never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins allowed to call the Render API.
CLIENT_ORIGIN=https://your-project.vercel.app

# Set true if you also want Vercel preview deployment URLs to work.
ALLOW_VERCEL_ORIGINS=false

# Render persistent disk mount path. Use /var/data after attaching a disk.
DATA_DIR=/var/data
